---
import '../styles/global.css';
import FiltroConMenuVenta from '../components/FiltroConMenuVenta.jsx';
import Formulario from "../components/Formulario.astro";

import Footer from "../components/Footer.astro";
import Navbar from "../components/NavBar"
---

<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pequevivo</title>
    <meta name="description" content="Pequevivo: expertos en animación infantil y alquiler de atracciones en El Viso del Alcor, Sevilla. Llenamos tus eventos de risas y diversión." />
    <link rel="icon" type="image/jpeg" href="/logoBueno.png" />
</head>
<body class="min-h-screen flex flex-col bg-gradient-to-br from-teal-500 via-sky-400 to-blue-600 text-gray-900">
<Navbar client:load />

<main class="flex-grow p-8 pt-20">

    <header class="max-w-6xl mx-auto mb-6 text-center">
        <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 via-orange-500 to-red-600 drop-shadow-2xl tracking-wide select-none">
            Pequevivo
        </h1>

        <p class="mt-3 text-3xl sm:text-4xl text-white/90 font-semibold drop-shadow-md">Expertos en animación y alquiler de atracciones</p>
        <p class="mt-1 text-xl sm:text-2xl text-white/80">De <span class="font-bold">El Viso del Alcor, Sevilla</span></p>
    </header>



    <h2 class="text-6xl font-extrabold text-white text-center mb-8 drop-shadow-lg">Nuestros Productos en Venta</h2>

    <section class="w-full max-w-7xl mx-auto mb-14 p-10 bg-white bg-opacity-30 rounded-2xl shadow-2xl text-center">
        <FiltroConMenuVenta client:load />
    </section>

    <section class="w-full max-w-7xl mx-auto mb-14 p-12 bg-white bg-opacity-40 rounded-2xl shadow-2xl text-center">
        <h3 class="text-4xl font-bold text-gray-800 mb-8 drop-shadow-md select-none">
            ¿Quieres saber más? ¡Contáctanos!
        </h3>
        <a
                href="https://wa.me/34654197649"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-6 bg-green-500 hover:bg-green-600 text-white text-2xl sm:text-3xl font-semibold rounded-lg shadow-lg transition duration-300 mx-auto"
        >
            Enviar WhatsApp
            <img src="/WhatsApp.svg.webp" alt="WhatsApp" class="inline-block w-8 h-8 ml-3 sm:w-10 sm:h-10" />
        </a>


    </section>






</main>

<Footer />
</body>
</html>
