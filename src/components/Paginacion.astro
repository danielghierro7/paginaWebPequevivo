---
const url = new URL(Astro.request.url);
const currentPath = url.pathname;
---

<div class="flex justify-center items-center min-h-[20vh]">
    <div class="inline-flex rounded-2xl shadow-lg overflow-hidden border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
        <a
                href="/"
                class={`px-8 py-4 text-lg font-bold border-r transition-all duration-200 focus:z-10 focus:ring-2 focus:ring-blue-700 ${
                    currentPath === '/'
                        ? 'text-gray-900 bg-white hover:bg-gray-100 hover:text-blue-700 dark:text-white dark:bg-gray-800 dark:hover:text-white dark:hover:bg-gray-700'
                        : 'text-white bg-blue-600 border-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 hover:bg-blue-700'
                }`}
        >
            Venta
        </a>
        <a
                href="/productosAlquiler"
                class={`px-8 py-4 text-lg font-bold transition-all duration-200 focus:z-10 focus:ring-2 focus:ring-blue-700 ${
                    currentPath === '/productosAlquiler'
                        ? 'text-gray-900 bg-white hover:bg-gray-100 hover:text-blue-700 dark:text-white dark:bg-gray-800 dark:hover:text-white dark:hover:bg-gray-700'
                        : 'text-white bg-blue-600 border-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 hover:bg-blue-700'
                }`}
        >
            Alquiler
        </a>
    </div>
</div>
